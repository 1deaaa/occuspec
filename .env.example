# 依赖服务连接配置
# 两种起服务方式，连法相同（应用默认连 127.0.0.1，因此无需改配置）：
#   1) docker compose up -d   一键起 MySQL + PostgreSQL/pgvector + Redis
#   2) 直接用本机已装好的服务
# 下面的密码同时被 docker-compose.yml 读取，改这里即可同步容器初始化密码。

# MySQL 业务库（建库由 compose 完成，表结构由 Flyway 迁移创建）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=occuspec
MYSQL_USER=root
MYSQL_PASSWORD=1009
# PostgreSQL 向量库（需 pgvector 扩展，compose 用 pgvector/pgvector:pg18）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=occuspec
PG_USER=postgres
PG_PASSWORD=1009
# Redis（需 6.0+：Sa-Token 会话持久化依赖 SET ... KEEPTTL，compose 用 redis:8-alpine）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=1009
# 对话模型（DashScope 兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=请填入真实密钥
LLM_MODEL=qwen3.8-flash
LLM_REASONING_EFFORT=xhigh
# 文本向量模型（SiliconFlow 兼容模式，dimensions=1024）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=请填入真实密钥
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
# 后端与前端地址
SERVER_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
