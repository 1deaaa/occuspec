# 本地开发环境变量（复制为 .env 后填入真实密钥，.env 永不提交）
# MySQL 业务库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=occuspec
MYSQL_USER=root
MYSQL_PASSWORD=1009
# PostgreSQL 向量库
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=occuspec
PG_USER=postgres
PG_PASSWORD=1009
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=1009
# 对话模型（DashScope 兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=请填入真实密钥
LLM_MODEL=qwen3.8-flash
LLM_REASONING_EFFORT=xhigh
# 文本向量模型（SiliconFlow 兼容模式，dimensions=1024）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=请填入真实密钥
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
# 后端与前端地址
SERVER_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
